{
  "name": "khanakya",
  "private": true,
  "version": "0.0.0",
  "description": "Ingredient-based personalized meal recommendations",
  "author": "KhaanaKya Project",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "db:setup": "node scripts/dbSetup.js",
    "db:push:remote": "supabase db push --yes",
    "db:seed": "node supabase/seed/seedCatalog.js",
    "db:validate": "node scripts/validateFoodData.js",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^39.1.2",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.90.0",
    "pg": "^8.23.1",
    "supabase": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^8.0.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "in.khaanakya.desktop",
    "productName": "KhaanaKya",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.food-and-drink",
      "protocols": [
        {
          "name": "KhaanaKya Authentication",
          "schemes": [
            "khaanakya"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
