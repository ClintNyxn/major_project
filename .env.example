# Supabase project URL and public anon or publishable key (never use a service-role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional alternative to VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional callback origin; defaults to the current web app origin
VITE_SUPABASE_REDIRECT_URL=
